{
  "permissions": {
    "allow": [
      "Bash(swift build:*)",
      "Bash(.build/debug/RAWSelect --selftest)",
      "Bash(.build/release/RAWSelect --selftest)",
      "Bash(./build_app.sh)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/open-latest-app.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
